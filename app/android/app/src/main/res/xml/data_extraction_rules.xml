<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Explicit exclusions also protect device-to-device transfers on Android 12+. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="gleam_secure_voice.xml" />
        <exclude domain="sharedpref" path="gleam_secure_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="gleam_secure_voice.xml" />
        <exclude domain="sharedpref" path="gleam_secure_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
