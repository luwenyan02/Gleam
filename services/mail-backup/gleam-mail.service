[Unit]
Description=Gleam private QQ mail backup relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gleam-mail
Group=gleam-mail
WorkingDirectory=/opt/gleam-mail
EnvironmentFile=/etc/gleam-mail.env
ExecStart=/usr/bin/python3 /opt/gleam-mail/server.py
StateDirectory=gleam-mail
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
